# ============================================================
# exact:state/ingame_task/craft_kit
# Called by: exact:state/ingame_task/enter (tasks 26-30)
# Executor:  each non-admin player
#
# The shared kit for every crafting task. container.9 upwards is
# the backpack, so the hotbar is left empty and players have to
# open their inventory to work.
#
# ============================================================

item replace entity @s container.9 with minecraft:stone 64
item replace entity @s container.10 with minecraft:cobblestone 64
item replace entity @s container.11 with minecraft:smooth_stone 64
item replace entity @s container.12 with minecraft:obsidian 64
item replace entity @s container.13 with minecraft:iron_ingot 64
item replace entity @s container.14 with minecraft:gold_ingot 64
item replace entity @s container.27 with minecraft:ender_pearl 16
item replace entity @s container.16 with minecraft:string 64
item replace entity @s container.17 with minecraft:oak_planks 64
item replace entity @s container.18 with minecraft:glass 64
item replace entity @s container.19 with minecraft:ghast_tear 64
item replace entity @s container.20 with minecraft:carrot 64
item replace entity @s container.21 with minecraft:cooked_rabbit 64
item replace entity @s container.22 with minecraft:red_mushroom 64
item replace entity @s container.23 with minecraft:beetroot 64
item replace entity @s container.24 with minecraft:baked_potato 64
item replace entity @s container.25 with minecraft:blaze_rod 64
item replace entity @s container.26 with minecraft:leather 64
