# ============================================================
# walls:player/armor_data
# Executor:  A Data player
#
# Protection II leather dyed Data pink (#e83d84 = 15220100).
# ============================================================

item replace entity @s armor.head with leather_helmet[dyed_color=15220100,enchantments={protection:2}]
item replace entity @s armor.chest with leather_chestplate[dyed_color=15220100,enchantments={protection:2}]
item replace entity @s armor.legs with leather_leggings[dyed_color=15220100,enchantments={protection:2}]
item replace entity @s armor.feet with leather_boots[dyed_color=15220100,enchantments={protection:2}]
