# ============================================================
# walls:player/armor_it
# Executor:  An IT player
#
# Protection II leather dyed IT purple (#cc99ff = 13408767).
# ============================================================

item replace entity @s armor.head with leather_helmet[dyed_color=13408767,enchantments={protection:2}]
item replace entity @s armor.chest with leather_chestplate[dyed_color=13408767,enchantments={protection:2}]
item replace entity @s armor.legs with leather_leggings[dyed_color=13408767,enchantments={protection:2}]
item replace entity @s armor.feet with leather_boots[dyed_color=13408767,enchantments={protection:2}]
